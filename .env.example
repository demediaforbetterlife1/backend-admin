# ═══════════════════════════════════════════════════════════════════════════
# Environment Configuration - Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Admin Seed Configuration
# FIX C-01: Required to create the initial admin account on first run.
# Must be at least 12 characters. Remove after first deployment.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_SEED_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_MIN_12_CHARS

# ─────────────────────────────────────────────────────────────────────────────
# Admin Seed (first-run only)
# Set this to create the initial admin account on first server start.
# Must be at least 12 characters. Remove after first login.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_SEED_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# ─────────────────────────────────────────────────────────────────────────────
# Redis (optional — used for VIP status caching)
# If not set, falls back to in-process memory cache.
# ─────────────────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration (PostgreSQL via Prisma)
# Format: postgresql://user:password@host:port/database
#
# For Neon Serverless PostgreSQL — append these query params to avoid
# "Error { kind: Closed }" noise from idle connection hibernation:
#   ?pgbouncer=true&connect_timeout=10&pool_timeout=10&connection_limit=5
#
# Example:
#   DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?pgbouncer=true&connect_timeout=10
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require&channel_binding=require

# ─────────────────────────────────────────────────────────────────────────────
# JWT Configuration
# Generate strong secrets: openssl rand -hex 32
# REQUIRED — server will refuse to start without these set to non-default values.
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_RANDOM_REFRESH_SECRET

# ─────────────────────────────────────────────────────────────────────────────
# Twilio Configuration (SMS/OTP)
# Required for phone-based OTP delivery.
# Get from: https://www.twilio.com/console
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ─────────────────────────────────────────────────────────────────────────────
# OAuth Configuration (Social Login)
# Required for social login token verification.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_CLIENT_ID=your_apple_bundle_id
# APPLE_PRIVATE_KEY=path_or_contents_of_apple_private_key
# APPLE_ISSUER_ID=your_apple_issuer_id

# ─────────────────────────────────────────────────────────────────────────────
# App Configuration
# ─────────────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
APP_NAME=Nexus Voice

# ─────────────────────────────────────────────────────────────────────────────
# LiveKit Configuration (Real-time Audio)
# REQUIRED in production — server will refuse to start with default values.
# Get from: https://livekit.io/ or deploy self-hosted
# ─────────────────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-livekit-server.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# For self-hosted LiveKit development only:
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# ─────────────────────────────────────────────────────────────────────────────
# Cloudinary Configuration (Voice Recording Uploads)
# ─────────────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─────────────────────────────────────────────────────────────────────────────
# CORS Configuration
# FIX M-07: Variable name is CORS_ORIGINS (plural) — comma-separated list.
# Required in production. In development, all origins are allowed if unset.
# ─────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://your-frontend.com,https://your-admin.com

# ─────────────────────────────────────────────────────────────────────────────
# In-App Purchase Configuration
# ALLOW_IAP_STUB=true enables stub receipt verification for local development.
# NEVER set this to true in staging or production — server will refuse to start.
# ─────────────────────────────────────────────────────────────────────────────
ALLOW_IAP_STUB=false

# ─────────────────────────────────────────────────────────────────────────────
# DEV_FREE_SUBSCRIPTIONS — development/testing only
#
# Set to true to enable the POST /vip/test-subscribe endpoint for ANY
# authenticated user (not just admins). This lets you activate any VIP/SVIP
# tier without spending coins so you can verify that every tier feature works
# before enabling real payments.
#
# NEVER set to true in staging or production — the server will refuse to start
# (validated in src/config/env.js alongside ALLOW_IAP_STUB).
#
# How to use locally:
#   1. Set DEV_FREE_SUBSCRIPTIONS=true in your .env
#   2. Call POST /vip/test-subscribe with {"tier":"VIP_3","autoRenew":false}
#   3. Verify the feature works, then reset with POST /vip/cancel
# ─────────────────────────────────────────────────────────────────────────────
DEV_FREE_SUBSCRIPTIONS=false

# Apple App Store receipt verification
APPLE_SHARED_SECRET=your_apple_shared_secret

# Google Play receipt verification (JSON service account credentials)
# GOOGLE_PLAY_CREDENTIALS={"type":"service_account","project_id":"..."}

# ─────────────────────────────────────────────────────────────────────────────
# Social Login Development Stub
# ALLOW_SOCIAL_STUB=true skips server-side token verification in development.
# NEVER set this to true in production.
# ─────────────────────────────────────────────────────────────────────────────
ALLOW_SOCIAL_STUB=false

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Service Account (Push Notifications)
# Use a single-line JSON environment variable with the entire service account JSON.
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id"}

# ─────────────────────────────────────────────────────────────────────────────
# Socket.IO Configuration
# ─────────────────────────────────────────────────────────────────────────────
SOCKET_IO_PING_INTERVAL=25000
SOCKET_IO_PING_TIMEOUT=20000

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# LOG_OTP=true        # Log OTP codes to console in development (never in production)
# LOG_RESET_TOKEN=true # Log password reset tokens to console in development

# ─────────────────────────────────────────────────────────────────────────────
# Redis Configuration (optional — falls back to in-memory cache if not set)
# FIX L-04: Redis initialized once at startup for VIP status caching.
# ─────────────────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# Legacy Signaling (WebRTC)
# Only enable for backward compatibility. Prefer the /room namespace.
# ─────────────────────────────────────────────────────────────────────────────
# ENABLE_LEGACY_SIGNALING=false

# ─────────────────────────────────────────────────────────────────────────────
# Admin Dashboard Seed (first-run only — idempotent, safe to leave in)
# Creates the initial SUPER_ADMIN dashboard account on first server start.
# ADMIN_SEED_PASSWORD must be at least 8 characters.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_SEED_EMAIL=testadmin@gmail.com
ADMIN_SEED_PASSWORD=testpassword
ADMIN_SEED_NAME=Super Admin

# ─────────────────────────────────────────────────────────────────────────────
# Internal Service Token
# Used by the Next.js dashboard to emit realtime events to Flutter via Express.
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_STRONG_RANDOM_TOKEN
