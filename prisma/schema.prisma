// ─── Admin Account (Dashboard Users) ─────────────────────────────────────────
// Separate from the User model — these are dashboard operators, not app users.

model AdminAccount {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // Soft-delete so audit history is preserved
  deletedAt    DateTime?

  refreshTokens AdminRefreshToken[]
  auditLogs     AdminAuditLog[]

  @@index([email])
  @@index([role])
  @@map("admin_accounts")
}

model AdminRefreshToken {
  id        String       @id @default(cuid())
  token     String       @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime     @default(now())
  admin     AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_refresh_tokens")
}

model AdminAuditLog {
  id         String       @id @default(cuid())
  adminId    String
  action     String
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime     @default(now())
  admin      AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@map("admin_audit_logs")
}

// App-level settings stored as key-value pairs
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// Promotional banners served to Flutter clients
model Banner {
  id        String    @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  screen    String?
  position  Int       @default(0)
  enabled   Boolean   @default(true)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([enabled, position])
  @@map("banners")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
}

// ─── Icon Management System ───────────────────────────────────────────────────

model AppIcon {
  id          String         @id @default(cuid())
  key         String         @unique
  category    IconCategory
  displayName String
  url         String
  storagePath String
  mimeType    String         @default("image/png")
  width       Int?
  height      Int?
  size        Int?
  version     Int            @default(1)
  isActive    Boolean        @default(true)
  isPublished Boolean        @default(false)
  isPending   Boolean        @default(false)
  etag        String?
  defaultUrl  String
  createdById String?
  updatedById String?
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  versions    IconVersion[]
  auditLogs   IconAuditLog[]

  @@index([category])
  @@index([isActive])
  @@index([key])
  @@map("app_icons")
}

model IconVersion {
  id           String   @id @default(cuid())
  iconId       String
  version      Int
  url          String
  storagePath  String
  mimeType     String
  width        Int?
  height       Int?
  size         Int?
  uploadedById String?
  createdAt    DateTime @default(now())
  icon         AppIcon  @relation(fields: [iconId], references: [id], onDelete: Cascade)

  @@index([iconId])
  @@index([iconId, version])
  @@map("icon_versions")
}

model IconAuditLog {
  id         String     @id @default(cuid())
  iconId     String
  adminId    String?
  action     IconAction
  oldVersion Int?
  newVersion Int?
  oldUrl     String?
  newUrl     String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime   @default(now())
  icon       AppIcon    @relation(fields: [iconId], references: [id], onDelete: Cascade)

  @@index([iconId])
  @@index([adminId])
  @@index([createdAt])
  @@map("icon_audit_logs")
}

enum IconCategory {
  NAVIGATION
  ROOM
  VOICE
  SOCIAL
  WALLET
  VIP
  MEDIA
  STATUS
  SETTINGS
  ADMIN
  ACTIONS
  STORE
}

enum IconAction {
  UPLOAD
