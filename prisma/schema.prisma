  DELETE
  RESTORE
  PUBLISH
  ROLLBACK
  REVERT_TO_DEFAULT
}

// ─── Agency Registration System ────────────────────────────────────────────

model AgencyRequest {
  id              String              @id @default(cuid())
  userId          String              @unique
  agencyName      String
  ownerName       String
  phone           String
  email           String?
  country         String?
  documents       Json? // Array of document URLs
  profileImage    String?
  bio             String?
  teamSize        String?
  offeredServices Json? // Array of services
  status          AgencyRequestStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?             // AdminAccount.id - NO FK RELATION (different model)
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // REMOVED: reviewedByAdmin relation because reviewedBy is AdminAccount.id, not User.id

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("agency_requests")
}

// ─── Agency System (Business Entity Management) ────────────────────────────

model Agency {
  id              String              @id @default(cuid())
  ownerId         String              @unique
  name            String              @unique
  description     String?
  country         String?
  profileImage    String?
  documents       Json?               // Array of document URLs
  teamSize        String?
  offeredServices Json?               // Array of services
  level           AgencyLevel         @default(STANDARD)
  commissionRate  Float               @default(0.0)
  status          AgencyStatus        @default(ACTIVE)
  totalEarnings   Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  owner           User                @relation("AgencyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships     AgencyMembership[]
  conversations   Conversation[]      @relation("AgencyConversations")
  
  @@index([ownerId])
  @@index([status])
  @@index([name])
  @@map("agencies")
}

model AgencyMembership {
  id         String              @id @default(cuid())
  agencyId   String
  userId     String
  role       AgencyMemberRole    @default(MEMBER)
  status     MembershipStatus    @default(PENDING)
  invitedBy  String
  invitedAt  DateTime            @default(now())
  joinedAt   DateTime?
  leftAt     DateTime?
  
  agency     Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user       User                @relation("AgencyMemberUsers", fields: [userId], references: [id], onDelete: Cascade)
  inviter    User                @relation("AgencyMemberInviters", fields: [invitedBy], references: [id])
  
  @@unique([agencyId, userId])
  @@index([agencyId, status])
  @@index([userId, status])
  @@map("agency_memberships")
}

enum AgencyLevel {
  STANDARD
  PREMIUM
  ELITE
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum AgencyMemberRole {
  MEMBER
  MANAGER
  OWNER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  LEFT
  REMOVED
}

enum AgencyRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
