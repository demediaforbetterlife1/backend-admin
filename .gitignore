# ─── Environment secrets — NEVER commit real credentials ─────────────────────
.env
.env.local
.env.*.local

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Prisma generated client (regenerated by `prisma generate`) ───────────────
# Keep migrations and schema in source control; exclude generated artefacts.
# node_modules/.prisma is already covered by node_modules/ above.

# ─── SQLite local dev database (if used) ─────────────────────────────────────
data/*.db
data/*.db-shm
data/*.db-wal

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── OS artefacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editor / IDE ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
